<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BelmontsCurseUltrawide</AssemblyName>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="$(GamePath)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/core/MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/*.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GamePath)/BepInEx/interop/Assembly-CSharp.dll')"
           Text="Set GamePath to the game directory after running BepInEx once." />
  </Target>
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <PackageRoot>$(BaseIntermediateOutputPath)package/</PackageRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageRoot)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageRoot)BepInEx/plugins" />
    <Copy SourceFiles="README.md;LICENSE" DestinationFolder="$(PackageRoot)BelmontsCurseUltrawide" />
    <MakeDir Directories="dist" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="dist/$(AssemblyName)-v$(Version).zip" Overwrite="true" />
  </Target>
</Project>
