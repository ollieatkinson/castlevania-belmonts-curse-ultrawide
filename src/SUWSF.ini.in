[UserSettings]
Resolution="auto"
Enabled=true

; Replace the highest resolution preset in both display and rendering tables.
[Patch:NativeWidth]
Pattern="BA 00 0F 00 00 4C 8B 0D ?? ?? ?? ?? 41 B8 ?? ?? ?? ?? 48 89 7D ?? E8 ?? ?? ?? ?? 83 7B 18 0B"
Offset=1
Value="width"
ValueType="int"
Match="all"
Module="GameAssembly.dll"

[Patch:NativeHeight]
Pattern="BA ?? ?? ?? ?? 4C 8B 0D ?? ?? ?? ?? 41 B8 70 08 00 00 48 89 7D ?? E8 ?? ?? ?? ?? 83 7B 18 0B"
Offset=14
Value="height"
ValueType="int"
Match="all"
Module="GameAssembly.dll"

; Allow the monitor's aspect ratio through the game's supported-mode filter.
[Patch:SupportedAspectRatio]
Pattern="80 79 40 00 74 04 32 C0 EB C2"
Offset=4
Value="EB"
ValueType="byte"
Match="1"
Module="GameAssembly.dll"

; Use Expand scaling: preserve UI size using height on ultrawide screens.
[Patch:UIHeightScaling]
Pattern="8B 4B 34 0F 57 F6 85 C9 74 39 83 E9 01 74 20 83 F9 01"
Offset=8
Value="EB 25"
ValueType="byte"
Match="1"
Module="GameAssembly.dll"

; Keep the world-space menu camera large enough for 16:10.
[Patch:00MenuCameraCode]
Pattern="48 8B 05 0D 9C CE 03 48 83 F8 0A 72 CD 48 83 C4 28 C3 CC CC 48 8D 0D A9 95 D0 03 E9 A0 56 FC FF"
Offset=36
Value="@MenuCameraCode@"
ValueType="byte"
Match="1"
Module="GameAssembly.dll"

; Keep the world-space menu camera large enough for 16:10.
[Patch:MenuCameraFit]
Pattern="E8 35 FB 5F 02 48 8B 4B 28 48 85 C9 0F 84 B8 02 00 00 45 33 C0 B2 01 E8 FE D6 63 02 48 8B 4B 20 48 85 C9 0F 84 A1 02 00"
Offset=23
Value="@MenuCameraCall@"
ValueType="byte"
Match="1"
Module="GameAssembly.dll"

; Preview: retain original camera boundaries on ultrawide.
[Patch:00ConfinerCode]
Pattern="48 8B 05 0D 9C CE 03 48 83 F8 0A 72 CD 48 83 C4 28 C3 CC CC 48 8D 0D A9 95 D0 03 E9 A0 56 FC FF"
Offset=116
Value="@ConfinerCode@"
ValueType="byte"
Match="1"
Module="GameAssembly.dll"

; Preview: retain original camera boundaries on ultrawide.
[Patch:ConfinerAspect]
Pattern="E8 6F 59 23 00 0F 28 D0 45 84 E4 0F 85 40 01 00 00 F3 0F 10 4F 60 F3 0F 5C CE 41 0F 54 CF 41 0F"
Offset=0
Value="@ConfinerAspectCall@"
ValueType="byte"
Match="1"
Module="GameAssembly.dll"
